<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View (Tree) -->
        <record id="view_estate_property_tree" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree string="Propiedades">
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="expected_price" widget="monetary"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_estate_property_kanban" model="ir.ui.view">
            <field name="name">estate.property.kanban</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <kanban default_group_by="property_type_id" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="expected_price"/>
                    <field name="property_type_id"/>
                    <field name="state"/>
                    <field name="currency_id"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click
                                #{state === 'sold' ? 'border-start border-success border-4' : ''}
                                #{state === 'canceled' ? 'border-start border-danger border-4' : ''}
                                #{state === 'offer_accepted' ? 'border-start border-info border-4' : ''}
                                #{state === 'offer_received' ? 'border-start border-warning border-4' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="property_type_id"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="expected_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'sold'"
                                               decoration-info="state == 'offer_accepted'"
                                               decoration-warning="state == 'offer_received'"
                                               decoration-danger="state == 'canceled'"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Form View (Form) -->
        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Propiedad">
                    <header>
                        <!-- Button: Confirm offer received (visible only in "new" state) -->
                        <button name="action_offer_received"
                                type="object"
                                string="Oferta Recibida"
                                class="oe_highlight"
                                invisible="state != 'new'"/>

                        <!-- Button: Accept offer (visible only in "offer received" state) -->
                        <button name="action_offer_accepted"
                                type="object"
                                string="Aceptar Oferta"
                                class="oe_highlight"
                                invisible="state != 'offer_received'"/>

                        <!-- Button: Sell (visible only in "offer accepted" state) -->
                        <button name="action_sold"
                                type="object"
                                string="Vender"
                                class="oe_highlight"
                                invisible="state != 'offer_accepted'"/>

                        <!-- Button: Cancel (visible in any state except sold/canceled) -->
                        <button name="action_cancel"
                                type="object"
                                string="Cancelar"
                                invisible="state in ('sold', 'canceled')"/>

                        <!-- Button: Reset (visible only in canceled state) -->
                        <button name="action_reset_to_new"
                                type="object"
                                string="Reabrir"
                                invisible="state != 'canceled'"/>

                        <!-- Status bar (the one you already have) -->
                        <field name="state" widget="statusbar"
                            statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de la propiedad..."/></h1>
                        </div>
                        <group>
                            <group string="Información General">
                                <field name="property_type_id"/>
                                <field name="description"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                                <field name="currency_id"/>
                            </group>
                            <group string="Precios y Detalles">
                                <field name="expected_price" widget="monetary"/>
                                <field name="selling_price" widget="monetary"/>
                                <field name="living_area"/>
                                <field name="price_per_sqm"/>
                                <field name="bedrooms"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_estate_property_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Buscar Propiedades">
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="postcode"/>

                    <filter name="filter_available" string="Disponibles" domain="[('state', '=', 'new')]"/>
                    <filter name="filter_not_sold" string="Sin vender" domain="[('state', 'not in', ['sold', 'canceled'])]"/>
                    <filter name="filter_sold" string="Vendidas" domain="[('state', '=', 'sold')]"/>

                    <separator/>

                    <filter name="filter_cheap" string="Económicas (&lt; 100.000)" domain="[('expected_price', '&lt;', 100000)]"/>
                    <filter name="filter_expensive" string="Premium (&gt;= 100.000)" domain="[('expected_price', '&gt;=', 100000)]"/>

                    <separator/>

                    <group expand="0" string="Agrupar por">
                        <filter name="group_by_type" string="Tipo de Propiedad" context="{'group_by': 'property_type_id'}"/>
                        <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_by_postcode" string="Código Postal" context="{'group_by': 'postcode'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Propiedades</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">kanban,tree,form</field>   <!-- ⬅️ Kanban PRIMERO -->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera propiedad!
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_estate_root" name="Inmobiliaria" sequence="10"/>
        <menuitem id="menu_estate_property" name="Propiedades" parent="menu_estate_root" sequence="10"/>
        <menuitem id="menu_estate_property_all"
                  name="Todas las Propiedades"
                  parent="menu_estate_property"
                  action="estate_property_action"
                  sequence="10"/>
    </data>
</odoo>