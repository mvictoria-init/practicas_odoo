<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View (Tree) -->
        <record id="view_estate_property_tree" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree string="Propiedades">
                    <field name="name"/>
                    <field name="property_type_id"/>
                    <field name="expected_price"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View (Form) -->
        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Propiedad">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de la propiedad..."/></h1>
                        </div>
                        <group>
                            <group string="Información General">
                                <field name="property_type_id"/>
                                <field name="description"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group string="Precios y Detalles">
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                                <field name="living_area"/>
                                <field name="price_per_sqm"/>
                                <field name="bedrooms"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Window Action -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Propiedades</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera propiedad!
                </p>
            </field>
        </record>

        <!-- MENÚS -->
        <menuitem id="menu_estate_root" name="Inmobiliaria" sequence="10"/>
        <menuitem id="menu_estate_property" name="Propiedades" parent="menu_estate_root" sequence="10"/>
        <menuitem id="menu_estate_property_all" 
                  name="Todas las Propiedades" 
                  parent="menu_estate_property" 
                  action="estate_property_action" 
                  sequence="10"/>
    </data>
</odoo>