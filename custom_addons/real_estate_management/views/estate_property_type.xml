<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View (Tree) -->
        <record id="view_estate_property_type_tree" model="ir.ui.view">
            <field name="name">estatepropertytype.tree.view</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <tree string="Tipos de Propiedad" editable="bottom">
                    <field name="name"/> 
                </tree>
            </field>
        </record>

        <!-- Form View (Form) -->
        <record id="view_estate_property_type_form" model="ir.ui.view">
            <field name="name">estatepropertytype.form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Propiedad">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Window Action -->
        <record id="estate_property_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Propiedades</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_estate_property_type" 
            name="Tipos de Propiedades" 
            parent="menu_estate_property"
            action="estate_property_type_action"
            sequence="20"/>
    </data>
</odoo>