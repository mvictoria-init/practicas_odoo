<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de Lista (Tree) -->
        <record id="student_tree_view" model="ir.ui.view">
            <field name="name">student.tree.view</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/> 
                    <field name="age"/> 
                </tree>
            </field>
        </record>

        <!-- Vista de Formulario (Form) -->
        <record id="student_form_view" model="ir.ui.view">
            <field name="name">student.form.view</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="age"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción de Ventana -->
        <record id="student_action" model="ir.actions.act_window">
            <field name="name">Student</field>
            <field name="res_model">school.student</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menús -->
        <menuitem id="menu_root" name="School"/>
        <menuitem id="menu_students" name="Students" parent="menu_root"/>
        <menuitem id="menu_students_list" name="Students List" parent="menu_students" action="student_action"/>
    </data>
</odoo>
